# tavern.phuyu.cloud — Web 原生单页特稿（v2 主交付物）+ 指南站 + LIVE proxy 反代 + 体验站
# v2 变更：root 切至 /opt/st-pre/web（单页特稿）；deck 放映版归档进仓库、生产下线；
# 404 兜底不再指向 deck.html；/guide/ 与 /live/ 原样保留
# 阶段5 新增：/play/ → st-lite（SillyTavern fork 体验站）；nginx 剥前缀反代 127.0.0.1:8000，
# st-lite config.yaml 的 basePath 需设为 '/play'（同源同证书，不再单开子域名）
#
# ⚠ 限流架构（2026-11-07 生产教训，勿回退）：
#   ① /play/ 整段【不做 limit_req】——ST 冷启动一次拉 ~200 个静态文件（resource storm），
#     逐 IP 限流会把整次启动打成 429、前端静默死在半路（表现为「Not connected to API!」）；
#     且会场整队共享出口 IP，30 人同时扫码互相挤兑。滥用防护由 playgate（并发+费用闸）
#     与认证端点限流承担。
#   ② 认证端点单独限流：location ^~ /play/api/users/（最长前缀必胜；proxy_pass 带 URI
#     剥前缀。regex location 里 proxy_pass 不许带 URI——nginx 硬规则）。

server {
    server_name tavern.phuyu.cloud;

    root /opt/st-pre/web;
    index index.html;

    location ^~ /guide/ {
        alias /opt/st-pre/guide/;
        index index.html;
    }

    location /live/ {
        proxy_pass http://127.0.0.1:3011/live/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 30s;
        limit_req zone=live burst=5 nodelay;
    }

    # ── 体验站（阶段5 · st-lite）：/play/ 前缀反代，ST 前端由 basePath 补丁适配子路径 ──
    location = /play { return 301 /play/; }
    location ^~ /play/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;      # st-lite config: forwardedHeaders.xRealIp
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;                          # SSE 流式回复不缓冲
        proxy_request_buffering off;
        proxy_read_timeout 300s;                      # 长回复
        client_max_body_size 50m;                     # 角色卡 PNG 导入
    }

    # 认证端点限流（登录/注册/改密；最长前缀胜过上面的 /play/）
    location ^~ /play/api/users/ {
        limit_req zone=play burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000/api/users/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location ~* \.(png|jpg|jpeg|mp4|webm|woff2|css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options nosniff always;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/tavern.phuyu.cloud/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/tavern.phuyu.cloud/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = tavern.phuyu.cloud) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name tavern.phuyu.cloud;
    return 404; # managed by Certbot


}
